<!DOCTYPE html>
{# CMDB values are external input: escape every value rendered into HTML.
   Security numbers come from the ServiceNow CMDB record (written by
   playbooks/security_to_cmdb.yml), so the report shows what the CMDB says. #}
{% set drifted = cmdb_report_records | selectattr('drift') | list %}
{% set accurate = cmdb_report_records | rejectattr('drift') | list %}
{% set ns = namespace(patch_now=0, exploits=0, fixable=0) %}
{% for h in cmdb_report_hosts %}
{%   set v = hostvars[h] %}
{%   set ns.patch_now = ns.patch_now + (v.u_cve_critical | default(0) | int) + (v.u_cve_important | default(0) | int) %}
{%   set ns.exploits = ns.exploits + (v.u_cve_known_exploit | default(0) | int) %}
{%   set ns.fixable = ns.fixable + (v.u_cve_total | default(0) | int) %}
{% endfor %}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cmdb_report_title | e }}</title>
<style>
  :root { --ink:#151515; --muted:#6a6e73; --line:#e4e6e9; --bg:#f5f6f8; --card:#fff;
          --bad:#a30000; --warn:#8f4700; --ok:#2a6224; --accent:#ee0000; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font-family:"Red Hat Text",-apple-system,"Segoe UI",Helvetica,Arial,sans-serif; font-size:14px; }
  .wrap { max-width:1180px; margin:0 auto; padding:36px 32px 48px; }
  .top { border-bottom:3px solid var(--accent); padding-bottom:16px; }
  h1 { font-family:"Red Hat Display",-apple-system,Helvetica,Arial,sans-serif; font-size:28px; margin:0; }
  .gen { font-size:13px; color:var(--muted); margin-top:6px; }
  .demo { display:inline-block; margin-top:10px; font-size:12px; font-weight:700; color:var(--warn);
          background:#fdefdc; border-radius:6px; padding:3px 10px; }
  .kpis { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin:24px 0; }
  .kpi { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px 18px; }
  .kpi .k { font-size:13px; color:var(--muted); font-weight:600; }
  .kpi .v { font-size:30px; font-weight:700; margin-top:4px; font-variant-numeric:tabular-nums; }
  .kpi .d { font-size:12px; color:var(--muted); margin-top:2px; }
  .red { color:var(--bad); } .amber { color:var(--warn); } .green { color:var(--ok); }
  .panel { background:var(--card); border:1px solid var(--line); border-radius:10px;
           padding:18px 22px; margin-bottom:16px; }
  .head { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
  h2 { font-size:16px; margin:0; }
  .sub { font-size:12px; color:var(--muted); margin-top:4px; }
  .chip { font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; white-space:nowrap; }
  .chip.ok { background:#e6f2e3; color:var(--ok); }
  .chip.bad { background:#fbe7e5; color:var(--bad); }
  .chip.warn { background:#fdefdc; color:var(--warn); }
  table { width:100%; border-collapse:collapse; margin-top:12px; }
  th { text-align:left; font-size:12px; color:var(--muted); padding:7px 10px; border-bottom:1px solid var(--line); }
  td { padding:9px 10px; border-bottom:1px solid var(--line); font-variant-numeric:tabular-nums; }
  th.n, td.n { text-align:right; }
  tr:last-child td { border-bottom:0; }
  td.diff { color:var(--bad); font-weight:700; }
  .facts { display:flex; flex-wrap:wrap; gap:8px 22px; font-size:12px; color:var(--muted); margin-top:12px; }
  .facts b { color:var(--ink); font-weight:600; }
  footer { margin-top:18px; font-size:12px; color:var(--muted); line-height:1.6; }
  .toprow { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; }
  .pdf { font:inherit; font-size:13px; font-weight:600; color:var(--ink); background:var(--card);
         border:1px solid #c7c9cc; border-radius:8px; padding:8px 16px; cursor:pointer; white-space:nowrap; }
  .pdf:hover { background:#eef0f2; }
  @media print {
    @page { size: landscape; margin: 10mm; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { background:#fff; }
    .wrap { max-width:none; padding:0; }
    .pdf { display:none; }
    .kpi, .panel, tr { break-inside: avoid; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="toprow">
      <h1>{{ cmdb_report_title | e }}</h1>
      {# Opens the browser's print dialog; choose "Save as PDF" as the destination. #}
      <button class="pdf" type="button" onclick="window.print()">Download PDF</button>
    </div>
    <div class="gen">Generated {{ cmdb_report_generated }} &middot; run {{ cmdb_report_resolved_run_id | e }}
      &middot; servers, OS and CVE counts from the ServiceNow CMDB; accuracy checked against live Ansible facts</div>
    <div class="demo">Demo environment &mdash; not production exposure</div>
  </div>

  <div class="kpis">
    <div class="kpi"><div class="k">Servers in CMDB</div><div class="v">{{ cmdb_report_hosts | length }}</div></div>
    <div class="kpi"><div class="k">Patch now</div>
      <div class="v {{ 'red' if ns.patch_now > 0 else 'green' }}">{{ ns.patch_now }}</div>
      <div class="d">critical + important CVEs with a fix</div></div>
    <div class="kpi"><div class="k">Known exploits</div>
      <div class="v {{ 'red' if ns.exploits > 0 else 'green' }}">{{ ns.exploits }}</div>
      <div class="d">CVEs actively exploited</div></div>
    <div class="kpi"><div class="k">CMDB out of date</div>
      <div class="v {{ 'amber' if drifted else 'green' }}">{{ drifted | length }}</div>
      <div class="d">records that differ from the server</div></div>
    <div class="kpi"><div class="k">Not scanned</div>
      <div class="v {{ 'amber' if cmdb_report_unreachable else 'green' }}">{{ cmdb_report_unreachable | length }}</div>
      <div class="d">in CMDB but unreachable</div></div>
  </div>

  <div class="panel">
    <h2>Servers as recorded in ServiceNow</h2>
    <div class="sub">One row per CMDB record. CVE counts come from Red Hat Lightspeed via the "Security facts to CMDB" job.</div>
    <table>
      <tr><th>Server</th><th>OS (CMDB)</th><th>Category</th>
        <th class="n">Critical</th><th class="n">Important</th><th class="n">All fixable</th>
        <th class="n">Known exploit</th><th class="n">No fix (crit/imp)</th>
        <th>Last package change</th><th>CMDB vs server</th></tr>
{% for h in cmdb_report_hosts | sort %}
{%   set v = hostvars[h] %}
{%   set r = cmdb_report_records | selectattr('host', 'equalto', h) | first | default({}) %}
      <tr>
        <td><b>{{ h | e }}</b><div class="sub">{{ v.ip_address | default('') | e }}</div></td>
        <td>{{ v.os | default('') | e }} {{ v.os_version | default('') | e }}</td>
        <td>{{ v.category | default('') | e }}</td>
        <td class="n {{ 'red' if v.u_cve_critical | default(0) | int > 0 }}">{{ v.u_cve_critical | default('&ndash;') }}</td>
        <td class="n {{ 'amber' if v.u_cve_important | default(0) | int > 0 }}">{{ v.u_cve_important | default('&ndash;') }}</td>
        <td class="n">{{ v.u_cve_total | default('&ndash;') }}</td>
        <td class="n {{ 'red' if v.u_cve_known_exploit | default(0) | int > 0 }}">{{ v.u_cve_known_exploit | default('&ndash;') }}</td>
        <td class="n">{{ v.u_cve_no_fix | default('&ndash;') }}</td>
        <td>{{ v.u_last_package_change | default('') | e }}</td>
        <td>
{% if not r %}<span class="chip warn">Not scanned</span>
{% elif r.drift %}<span class="chip bad">Differs: {{ r.drift | join(', ') }}</span>
{% else %}<span class="chip ok">Matches</span>{% endif %}
        </td>
      </tr>
{% endfor %}
    </table>
  </div>

{% for r in cmdb_report_records | sort(attribute='host') %}
  <div class="panel">
    <div class="head">
      <div>
        <h2>{{ r.host | e }}: CMDB record vs live server</h2>
        <div class="sub">{{ r.category | e }}{% if r.environment %} &middot; {{ r.environment | e }}{% endif %}
          &middot; CMDB record updated {{ r.cmdb_updated | e if r.cmdb_updated else 'unknown' }}
          {% if r.security.last_scan %}&middot; Lightspeed evaluated {{ r.security.last_scan | e }}{% endif %}</div>
      </div>
{% if r.drift %}
      <span class="chip bad">CMDB differs on {{ r.drift | length }} field{{ 's' if r.drift | length != 1 }}</span>
{% else %}
      <span class="chip ok">Matches the CMDB</span>
{% endif %}
    </div>
    <table>
      <tr><th>Field</th><th>In the CMDB</th><th>On the host</th></tr>
{% for c in r.checks %}
      <tr><td>{{ c.field }}</td>
        <td{% if not c.match %} class="diff"{% endif %}>{{ c.cmdb | e if c.cmdb else 'not recorded' }}</td>
        <td>{{ c.actual | e }}</td></tr>
{% endfor %}
    </table>
    <div class="facts">
      <span>OS <b>{{ r.facts.os | e }}</b></span>
      <span>Kernel <b>{{ r.facts.kernel | e }}</b></span>
      <span>vCPUs <b>{{ r.facts.vcpus }}</b></span>
      <span>Memory <b>{{ r.facts.memory_mb }} MB</b></span>
      <span>Uptime <b>{{ r.facts.uptime_days }} days</b></span>
      <span>SELinux <b>{{ r.facts.selinux | e }}</b></span>
    </div>
  </div>
{% endfor %}

{% for h in cmdb_report_unreachable | sort %}
  <div class="panel">
    <div class="head">
      <div>
        <h2>{{ h | e }}</h2>
        <div class="sub">Listed in the CMDB at {{ hostvars[h].ip_address | default('no address') | e }}</div>
      </div>
      <span class="chip warn">No facts: unreachable or failed</span>
    </div>
  </div>
{% endfor %}

  <footer>
    "Patch now" counts critical and important CVEs that already have a Red Hat fix. CVE numbers are as stored in
    ServiceNow by the most recent "Security facts to CMDB" run. A server "matches" when the CMDB's hostname, FQDN,
    IP address and OS version equal what the server reports; run "Sync CMDB from facts" to correct records.
    Servers that could not be scanned are listed as missing evidence, never as accurate.
  </footer>
</div>
</body>
</html>
